<section class="atmos" id="video">
  <div class="container">
    <div class="atmos__inner">
      <div class="atmos__media" id="videoBox">
        {%- if section.settings.video != blank -%}
          {{ section.settings.video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true, preload: 'metadata', image_size: '1400x', class: 'atmos__video' }}
        {%- elsif section.settings.video_url.type == 'youtube' -%}
          <div class="atmos__embed">
            <iframe src="https://www.youtube-nocookie.com/embed/{{ section.settings.video_url.id }}?autoplay=1&mute=1&loop=1&playlist={{ section.settings.video_url.id }}&controls=0&rel=0&modestbranding=1&playsinline=1" title="{{ section.settings.heading | escape }}" allow="autoplay; encrypted-media; picture-in-picture" loading="lazy"></iframe>
          </div>
        {%- elsif section.settings.video_url.type == 'vimeo' -%}
          <div class="atmos__embed">
            <iframe src="https://player.vimeo.com/video/{{ section.settings.video_url.id }}?autoplay=1&muted=1&loop=1&background=1" title="{{ section.settings.heading | escape }}" allow="autoplay; fullscreen; picture-in-picture" loading="lazy"></iframe>
          </div>
        {%- elsif section.settings.poster != blank -%}
          {{ section.settings.poster | image_url: width: 1400 | image_tag: loading: 'lazy', alt: '' }}
        {%- else -%}
          <img src="{{ 'video-poster.jpg' | asset_img_url: '1400x' }}" alt="" width="1254" height="836" loading="lazy">
        {%- endif -%}
      </div>

      <div class="atmos__copy">
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--light">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2 class="atmos__title">{{ section.settings.heading | escape }}</h2>
        {%- if section.settings.text != blank -%}<p class="atmos__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
        {%- if section.blocks.size > 0 -%}
          <ul class="atmos__list">
            {%- for block in section.blocks -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', icon: block.settings.icon, size: 'lg' %}
                <span>{{ block.settings.text | newline_to_br }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Video",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "No music. Just magic." },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Pure Atmosphere" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Our levitating globe is designed for one purpose — to bring beauty, calm and inspiration into your space. No noise, no distractions, just the mesmerising sight of a floating world and a soft, ambient glow." },
    { "type": "video", "id": "video", "label": "Video (uploaded)", "info": "Plays automatically, muted and looping. Upload under Content › Files." },
    { "type": "video_url", "id": "video_url", "label": "Or a YouTube / Vimeo link", "accept": ["youtube", "vimeo"], "info": "Used when no uploaded video is set." },
    { "type": "image_picker", "id": "poster", "label": "Image shown when there is no video", "info": "Leave empty to use the built-in photo." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "moon",
          "options": [
            { "value": "moon", "label": "Moon" },
            { "value": "mute", "label": "Mute" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "sun", "label": "Sun" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" }
          ]
        },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Calming\nAtmosphere" }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Video",
      "blocks": [
        { "type": "point", "settings": { "icon": "moon", "text": "Calming\nAtmosphere" } },
        { "type": "point", "settings": { "icon": "mute", "text": "Distraction Free" } },
        { "type": "point", "settings": { "icon": "sparkle", "text": "A Timeless\nConversation Piece" } }
      ]
    }
  ]
}
{% endschema %}
