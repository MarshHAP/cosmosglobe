<section class="setup" id="setup">
  <div class="container">
    {%- if section.settings.eyebrow != blank -%}<p class="eyebrow eyebrow--center">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h2 class="h2">{{ section.settings.heading | escape }}</h2>{%- endif -%}
    {%- if section.settings.text != blank -%}<p class="setup__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ol class="steps">
        {%- for block in section.blocks -%}
          <li class="step" {{ block.shopify_attributes }}>
            <div class="step__head"><span class="step__num">{{ forloop.index }}</span><h3>{{ block.settings.title | escape }}</h3></div>
            {%- if block.settings.image != blank -%}
              {{ block.settings.image | image_url: width: 640 | image_tag: loading: 'lazy', alt: block.settings.title }}
            {%- else -%}
              {%- assign fallback = 'step-' | append: forloop.index | append: '.svg' -%}
              <img src="{{ fallback | asset_url }}" alt="" width="320" height="180" loading="lazy">
            {%- endif -%}
            <p>{{ block.settings.text | escape }}</p>
          </li>
        {%- endfor -%}
      </ol>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Setup steps",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "It's simple" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How to Set This Up" },
    { "type": "text", "id": "text", "label": "Text", "default": "Get your floating globe ready in just a few steps." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Connect & Power" },
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the built-in illustration for steps 1–3." },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Plug in the power cable and place the stand on a flat surface." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "Setup steps",
      "blocks": [
        { "type": "step", "settings": { "title": "Connect & Power", "text": "Plug in the power cable and place the stand on a flat surface." } },
        { "type": "step", "settings": { "title": "Position the Globe", "text": "Hold the globe between the top and bottom. Slowly move it until you feel it lift and stabilise." } },
        { "type": "step", "settings": { "title": "Enjoy the Magic", "text": "Once it floats, give it a gentle spin and enjoy your world." } }
      ]
    }
  ]
}
{% endschema %}
