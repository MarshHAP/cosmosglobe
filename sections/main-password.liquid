<section class="password">
  <div class="container container--narrow password__inner">
    <p class="logo">{{ settings.logo_text | default: shop.name | escape }}</p>
    <img class="password__img" src="{{ 'hero-globe.svg' | asset_url }}" alt="" width="360" height="360">
    <h1 class="h2">{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p class="page-lead">{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter newsletter--center' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      <label class="sr-only" for="PasswordEmail">Email address</label>
      <input id="PasswordEmail" type="email" name="contact[email]" placeholder="Your email address" required>
      <button type="submit" aria-label="Subscribe">{% render 'icon', icon: 'arrow' %}</button>
      {%- if form.posted_successfully? -%}<p class="newsletter__msg">Thanks. We'll let you know when we open.</p>{%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Enter using password</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        {{ form.errors | default_errors }}
        <label class="sr-only" for="Password">Password</label>
        <input id="Password" type="password" name="password" placeholder="Password" required>
        <button class="btn btn--primary" type="submit">Enter</button>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "A brighter world is coming" }
  ]
}
{% endschema %}
