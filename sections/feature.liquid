{%- liquid
  assign points = section.blocks | where: 'type', 'point'
  assign slides = section.blocks | where: 'type', 'slide'
  assign slide_count = slides.size
-%}
<section class="feature" id="about" data-section-id="{{ section.id }}">
  <div class="container feature__inner">
    <div class="feature__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2 h2--left">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="feature__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    {%- if points.size > 0 -%}
      <ul class="feature__list">
        {%- for block in points -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', icon: block.settings.icon, size: 'lg' %}
            <span>{{ block.settings.text | newline_to_br }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <div class="feature__visual">
      <div class="carousel" data-carousel aria-roledescription="carousel" aria-label="{{ section.settings.eyebrow | default: 'Gallery' | escape }}">
        <div class="carousel__track" data-carousel-track>
          {%- if slide_count > 0 -%}
            {%- for block in slides -%}
              <figure class="carousel__slide" data-carousel-slide aria-roledescription="slide" aria-label="{{ forloop.index }} of {{ slide_count }}" {{ block.shopify_attributes }}>
                {%- if block.settings.image != blank -%}
                  {%- assign slide_alt = block.settings.image.alt | default: block.settings.caption | default: section.settings.heading | strip_html -%}
                  {{ block.settings.image | image_url: width: 1200 | image_tag: widths: '500, 800, 1200', sizes: '(max-width: 1080px) 100vw, 480px', loading: 'lazy', alt: slide_alt }}
                {%- else -%}
                  {%- assign fallback = 'pdp-' | append: block.settings.fallback | append: '.jpg' -%}
                  <img src="{{ fallback | asset_img_url: '1200x' }}" srcset="{{ fallback | asset_img_url: '600x' }} 600w, {{ fallback | asset_img_url: '1200x' }} 1200w" sizes="(max-width: 1080px) 100vw, 480px" alt="{{ block.settings.caption | default: 'COSMOS mechanism' | escape }}" width="1254" height="1254" loading="lazy">
                {%- endif -%}
                {%- if block.settings.caption != blank -%}<figcaption class="carousel__caption">{{ block.settings.caption | escape }}</figcaption>{%- endif -%}
              </figure>
            {%- endfor -%}
          {%- else -%}
            <figure class="carousel__slide" data-carousel-slide>
              <img src="{{ 'pdp-3-mechanism.jpg' | asset_img_url: '1200x' }}" alt="Balanced magnetic fields keep the globe suspended" width="1254" height="1254" loading="lazy">
            </figure>
          {%- endif -%}
        </div>
        {%- if slide_count > 1 -%}
          <button class="carousel__btn carousel__btn--prev" type="button" data-carousel-prev aria-label="Previous image">{% render 'icon', icon: 'chevron-left' %}</button>
          <button class="carousel__btn carousel__btn--next" type="button" data-carousel-next aria-label="Next image">{% render 'icon', icon: 'chevron-right' %}</button>
          <div class="carousel__dots" data-carousel-dots role="tablist" aria-label="Choose image">
            {%- for block in slides -%}
              <button type="button" role="tab" data-carousel-dot="{{ forloop.index0 }}" aria-label="Image {{ forloop.index }}" {% if forloop.first %}aria-selected="true"{% endif %}></button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "About / mechanism",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The mechanism" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>It shouldn't work.</p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Magnets alone can't hold anything in mid-air. An electromagnet in the upper arm lifts the globe while a sensor tracks its position, adjusting the field hundreds of times a second. What looks perfectly still is correcting itself constantly — silently, and far too fast to see." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore COSMOS" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "paragraph", "content": "Add 'Image' blocks to build the 1:1 carousel. Add 'Feature point' blocks for the bullet list." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "sensor",
          "options": [
            { "value": "sensor", "label": "Sensor" },
            { "value": "magnet", "label": "Magnet" },
            { "value": "spin", "label": "Spin" },
            { "value": "mute", "label": "Silent" },
            { "value": "globe", "label": "Globe" },
            { "value": "sun", "label": "Sun" },
            { "value": "home", "label": "Home" },
            { "value": "heart", "label": "Heart" },
            { "value": "book", "label": "Book" },
            { "value": "moon", "label": "Moon" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Sensor-Guided\nLevitation" }
      ]
    },
    {
      "type": "slide",
      "name": "Image",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image", "info": "Square (1:1) images look best." },
        {
          "type": "select",
          "id": "fallback",
          "label": "Built-in image (used when no image is uploaded)",
          "default": "3-mechanism",
          "options": [
            { "value": "3-mechanism", "label": "Balanced magnetic fields" },
            { "value": "4-details", "label": "Refined in every edge" },
            { "value": "8-specs", "label": "Specifications" },
            { "value": "2-reveal", "label": "Cosmos Original" },
            { "value": "5-night", "label": "At night" },
            { "value": "6-desk", "label": "On a desk" },
            { "value": "9-box", "label": "In the box" }
          ]
        },
        { "type": "text", "id": "caption", "label": "Caption" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "About / mechanism",
      "blocks": [
        { "type": "point", "settings": { "icon": "sensor", "text": "Sensor-Guided\nLevitation" } },
        { "type": "point", "settings": { "icon": "magnet", "text": "Self-Correcting\nMagnetic Field" } },
        { "type": "point", "settings": { "icon": "spin", "text": "Frictionless\nFree Spin" } },
        { "type": "point", "settings": { "icon": "mute", "text": "Silent\nNo Moving Parts" } },
        { "type": "slide", "settings": { "fallback": "3-mechanism" } },
        { "type": "slide", "settings": { "fallback": "4-details" } },
        { "type": "slide", "settings": { "fallback": "8-specs" } }
      ]
    }
  ]
}
{% endschema %}
