<section class="feature" id="about">
  <div class="container feature__inner">
    <div class="feature__copy">
      {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
      <h2 class="h2 h2--left">{{ section.settings.heading }}</h2>
      {%- if section.settings.text != blank -%}<p class="feature__lead">{{ section.settings.text | escape }}</p>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="btn btn--primary" href="{{ section.settings.button_link | default: '#shop' }}">{{ section.settings.button_label | escape }} <span aria-hidden="true">→</span></a>
      {%- endif -%}
    </div>

    {%- if section.blocks.size > 0 -%}
      <ul class="feature__list">
        {%- for block in section.blocks -%}
          <li {{ block.shopify_attributes }}>
            {% render 'icon', icon: block.settings.icon, size: 'lg' %}
            <span>{{ block.settings.text | newline_to_br }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}

    <figure class="feature__visual">
      {%- if section.settings.image != blank -%}
        {%- assign feature_alt = section.settings.image.alt | default: 'COSMOS globe lamp in a living space' -%}
        {{ section.settings.image | image_url: width: 1400 | image_tag: widths: '700, 1000, 1400', sizes: '(max-width: 1080px) 100vw, 60vw', loading: 'lazy', alt: feature_alt }}
      {%- else -%}
        <img src="{{ 'lifestyle.svg' | asset_url }}" alt="White COSMOS globe lamp on a marble side table next to a stack of books" width="900" height="600" loading="lazy">
      {%- endif -%}
    </figure>
  </div>
</section>

{% schema %}
{
  "name": "Feature with image",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Beauty in motion" },
    { "type": "richtext", "id": "heading", "label": "Heading", "default": "<p>Bring the World<br>to Your Space</p>" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "A mesmerising floating globe that spins gently in mid-air, powered by magnetic levitation. With soft, ambient LED lighting, it transforms any room into a place of wonder, focus and inspiration." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Explore COSMOS" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "image_picker", "id": "image", "label": "Image", "info": "Leave empty to use the built-in lifestyle illustration." }
  ],
  "blocks": [
    {
      "type": "point",
      "name": "Feature point",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "globe",
          "options": [
            { "value": "globe", "label": "Globe" },
            { "value": "sun", "label": "Sun" },
            { "value": "home", "label": "Home" },
            { "value": "heart", "label": "Heart" },
            { "value": "book", "label": "Book" },
            { "value": "moon", "label": "Moon" },
            { "value": "sparkle", "label": "Sparkle" }
          ]
        },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Levitates\nMagnetically" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Feature with image",
      "blocks": [
        { "type": "point", "settings": { "icon": "globe", "text": "Levitates\nMagnetically" } },
        { "type": "point", "settings": { "icon": "sun", "text": "Soothing\nLED Light" } },
        { "type": "point", "settings": { "icon": "home", "text": "Perfect For\nHome & Office" } },
        { "type": "point", "settings": { "icon": "heart", "text": "Great For\nAll Ages" } }
      ]
    }
  ]
}
{% endschema %}
