<section class="product product--page" data-section-id="{{ section.id }}">
  <div class="container">
    {%- render 'product-card', product: product, section: section -%}
    {%- if product.description != blank -%}
      <div class="rte product__description">{{ product.description }}</div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product page",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "subtitle", "label": "Subtitle" },
    { "type": "checkbox", "id": "show_rating", "label": "Show star rating", "default": true },
    { "type": "text", "id": "rating_score", "label": "Rating score", "default": "4.9" },
    { "type": "text", "id": "rating_count", "label": "Number of reviews", "default": "377" },
    { "type": "text", "id": "price_note", "label": "Price note", "default": "Price includes VAT" },
    { "type": "header", "content": "Under the button" },
    { "type": "checkbox", "id": "show_payment_icons", "label": "Show payment icons", "default": true },
    { "type": "checkbox", "id": "show_delivery", "label": "Show delivery estimate", "default": true },
    { "type": "range", "id": "delivery_min_days", "label": "Earliest delivery (days from today)", "min": 1, "max": 30, "step": 1, "default": 10 },
    { "type": "range", "id": "delivery_max_days", "label": "Latest delivery (days from today)", "min": 1, "max": 45, "step": 1, "default": 17 }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Trust badge",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "truck",
          "options": [
            { "value": "truck", "label": "Truck" },
            { "value": "shield", "label": "Shield" },
            { "value": "lock", "label": "Lock" },
            { "value": "heart", "label": "Heart" },
            { "value": "globe", "label": "Globe" }
          ]
        },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Worldwide\nShipping" }
      ]
    }
  ],
  "max_blocks": 4
}
{% endschema %}
