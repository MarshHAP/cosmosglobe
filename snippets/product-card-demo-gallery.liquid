{%- comment -%} Built-in illustration gallery, used when a product has no images or no product is assigned. {%- endcomment -%}
{%- assign names = 'silver,pink,aqua,black,midnight,gold' | split: ',' -%}
<ul class="gallery__thumbs" aria-label="Product images">
  {%- for name in names -%}
    {%- assign file = 'globe-' | append: name | append: '.svg' -%}
    <li>
      <button type="button" class="thumb{% if name == 'black' %} is-active{% endif %}" data-thumb data-src="{{ file | asset_url }}" aria-label="{{ name | capitalize }}">
        <img src="{{ file | asset_url }}" alt="" width="60" height="60" loading="lazy">
      </button>
    </li>
  {%- endfor -%}
</ul>
<div class="gallery__main">
  <img id="MainImage-{{ section.id }}" data-main-image src="{{ 'globe-black.svg' | asset_url }}" alt="COSMOS Magnetic Levitating Globe Lamp in Black" width="600" height="600">
</div>
