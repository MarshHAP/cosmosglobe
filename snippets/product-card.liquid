{%- comment -%}
  Product card: gallery + buybox. Usage:
    {% render 'product-card', product: product, section: section %}
  Falls back to demo content when no product is assigned (so the design is visible in the editor).
{%- endcomment -%}
{%- liquid
  assign known_swatches = 'silver,pink,aqua,black,midnight,gold' | split: ','
  assign current = product.selected_or_first_available_variant
  assign form_id = 'ProductForm-' | append: section.id
-%}

<div class="product__card" data-product-card>
  {%- if product != blank -%}
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="gallery">
      {%- if product.media.size > 0 -%}
        <ul class="gallery__thumbs" aria-label="Product images">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="thumb{% if media.id == current.featured_media.id or forloop.first and current.featured_media == blank %} is-active{% endif %}" data-thumb data-media-id="{{ media.id }}" data-src="{{ media | image_url: width: 1000 }}" aria-label="{{ media.alt | default: product.title | escape }}">
                {{ media | image_url: width: 160, height: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <div class="gallery__main">
          {%- assign main_media = current.featured_media | default: product.featured_media -%}
          {%- assign main_id = 'MainImage-' | append: section.id -%}
          {%- assign main_alt = main_media.alt | default: product.title -%}
          {{ main_media | image_url: width: 1000 | image_tag: id: main_id, data-main-image: '', widths: '500, 800, 1000', sizes: '(max-width: 860px) 90vw, 470px', alt: main_alt }}
        </div>
      {%- else -%}
        {%- render 'product-card-demo-gallery', section: section -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buybox ---------- {%- endcomment -%}
    {%- form 'product', product, id: form_id, class: 'buybox', data-product-form: '' -%}
      <h2 class="buybox__title">{{ product.title | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}<p class="buybox__sub">{{ section.settings.subtitle | escape }}</p>{%- endif -%}

      {%- if section.settings.show_rating -%}
        <a class="rating" href="{{ routes.root_url }}#reviews">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="rating__score">{{ section.settings.rating_score | escape }}</span>
          <span class="rating__count">({{ section.settings.rating_count | escape }} reviews)</span>
        </a>
      {%- endif -%}

      <div class="price">
        <span class="price__now" data-price>{{ current.price | money }}</span>
        {%- if section.settings.price_note != blank -%}<span class="price__vat">{{ section.settings.price_note | escape }}</span>{%- endif -%}
      </div>

      {%- liquid
        assign promo = ''
        if current.compare_at_price > current.price
          assign saving = current.compare_at_price | minus: current.price | money
          assign promo = saving | append: ' off on ' | append: current.compare_at_price | money
        elsif section.settings.promo_text != blank
          assign promo = section.settings.promo_text
        endif
      -%}
      <div class="promo" role="status" data-promo {% if promo == blank %}hidden{% endif %}>
        <span class="promo__badge" aria-hidden="true">{% render 'icon', icon: 'tag' %}</span>
        <span class="promo__text" data-promo-text>{{ promo }}</span>
        {% render 'icon', icon: 'chevron-right', size: 'chev', class: 'promo__chev' %}
      </div>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_idx = forloop.index0
            assign option_name_down = option.name | downcase
            assign is_color = false
            if option_name_down contains 'colo'
              assign is_color = true
            endif
          -%}
          <fieldset class="option" data-option-index="{{ opt_idx }}">
            <legend class="option__label">{{ option.name | escape }}: <span data-option-value>{{ option.selected_value | escape }}</span></legend>
            <div class="{% if is_color %}swatches{% else %}pills{% endif %}">
              {%- for value in option.values -%}
                {%- assign input_id = form_id | append: '-' | append: opt_idx | append: '-' | append: forloop.index -%}
                {%- if is_color -%}
                  {%- liquid
                    assign swatch_src = ''
                    for variant in product.variants
                      if variant.options[opt_idx] == value and variant.featured_image != blank and swatch_src == ''
                        assign swatch_src = variant.featured_image | image_url: width: 120, height: 120
                      endif
                    endfor
                    assign value_handle = value | handleize
                    if swatch_src == '' and known_swatches contains value_handle
                      assign asset_name = 'globe-' | append: value_handle | append: '.svg'
                      assign swatch_src = asset_name | asset_url
                    endif
                  -%}
                  <label class="swatch" title="{{ value | escape }}">
                    <input type="radio" id="{{ input_id }}" name="option-{{ opt_idx }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %}>
                    {%- if swatch_src != '' -%}
                      <img src="{{ swatch_src }}" alt="{{ value | escape }}" width="54" height="54">
                    {%- else -%}
                      <span class="swatch__dot" style="background: {{ value | downcase | escape }};" aria-hidden="true"></span>
                      <span class="sr-only">{{ value | escape }}</span>
                    {%- endif -%}
                  </label>
                {%- else -%}
                  <label class="pill">
                    <input type="radio" id="{{ input_id }}" name="option-{{ opt_idx }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %}>
                    <span>{{ value | escape }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
        {%- endfor -%}
      {%- endunless -%}

      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <button class="btn btn--primary btn--block" type="submit" name="add" data-add-to-cart {% unless current.available %}disabled{% endunless %}>
        {% render 'icon', icon: 'cart' %}
        <span data-add-label>{% if current.available %}Add to Cart{% else %}Sold out{% endif %}</span>
      </button>

      {%- if section.blocks.size > 0 -%}
        <ul class="trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', icon: block.settings.icon, size: 'lg' %}
                <span>{{ block.settings.text | newline_to_br }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <script type="application/json" data-variants>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | money | json }},
              "promo": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | minus: variant.price | money | append: ' off on ' | append: variant.compare_at_price | money | json }}{% elsif section.settings.promo_text != blank %}{{ section.settings.promo_text | json }}{% else %}""{% endif %},
              "image": {% if variant.featured_media != blank %}{{ variant.featured_media | image_url: width: 1000 | json }}{% else %}null{% endif %},
              "media_id": {% if variant.featured_media != blank %}{{ variant.featured_media.id }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endform -%}

  {%- else -%}
    {%- comment -%} ---------- No product assigned: demo content ---------- {%- endcomment -%}
    <div class="gallery">{%- render 'product-card-demo-gallery', section: section -%}</div>
    <div class="buybox">
      <h2 class="buybox__title">COSMOS Magnetic Levitating Globe Lamp</h2>
      <p class="buybox__sub">{{ section.settings.subtitle | default: 'Education Novelty Ball Light Desk Bookshelf Home Decoration' | escape }}</p>
      <a class="rating" href="#reviews"><span class="stars" aria-hidden="true">★★★★★</span><span class="rating__score">4.9</span><span class="rating__count">(377 reviews)</span></a>
      <div class="price"><span class="price__now">{{ 1369 | money }}</span><span class="price__vat">{{ section.settings.price_note | default: 'Price includes VAT' | escape }}</span></div>
      <div class="promo" role="status">
        <span class="promo__badge" aria-hidden="true">{% render 'icon', icon: 'tag' %}</span>
        <span class="promo__text">{{ section.settings.promo_text | default: '£6.00 off on £49.00' }}</span>
        {% render 'icon', icon: 'chevron-right', size: 'chev', class: 'promo__chev' %}
      </div>
      <fieldset class="option">
        <legend class="option__label">Color: <span>Black</span></legend>
        <div class="swatches">
          {%- for name in known_swatches -%}
            <label class="swatch" title="{{ name | capitalize }}"><input type="radio" name="demo-color" value="{{ name }}" {% if name == 'black' %}checked{% endif %} disabled><img src="{{ 'globe-' | append: name | append: '.svg' | asset_url }}" alt="{{ name | capitalize }}" width="54" height="54"></label>
          {%- endfor -%}
        </div>
      </fieldset>
      <fieldset class="option">
        <legend class="option__label">Size: <span>UK plug</span></legend>
        <div class="pills">
          {%- assign plugs = 'EU plug,US plug,UK plug,AU plug' | split: ',' -%}
          {%- for plug in plugs -%}
            <label class="pill"><input type="radio" name="demo-size" value="{{ plug }}" {% if plug == 'UK plug' %}checked{% endif %} disabled><span>{{ plug }}</span></label>
          {%- endfor -%}
        </div>
      </fieldset>
      <button class="btn btn--primary btn--block" type="button" disabled title="Select a product in the theme editor">{% render 'icon', icon: 'cart' %}<span>Add to Cart</span></button>
      <p class="buybox__hint">Select a product for this section in the theme editor to make it shoppable.</p>
      {%- if section.blocks.size > 0 -%}
        <ul class="trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', icon: block.settings.icon, size: 'lg' %}<span>{{ block.settings.text | newline_to_br }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
