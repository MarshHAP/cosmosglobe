{%- comment -%}
  Product card: gallery + buybox. Usage:
    {% render 'product-card', product: product, section: section %}
  Falls back to demo content when no product is assigned (so the design is visible in the editor).
{%- endcomment -%}
{%- liquid
  assign current = product.selected_or_first_available_variant
  assign swatch_assets = 'black,white' | split: ','
  assign form_id = 'ProductForm-' | append: section.id
-%}

<div class="product__card" data-product-card>
  {%- if product != blank -%}
    {%- comment -%} ---------- Gallery ---------- {%- endcomment -%}
    <div class="gallery">
      {%- if product.media.size > 0 -%}
        <ul class="gallery__thumbs" aria-label="Product images">
          {%- for media in product.media -%}
            <li>
              <button type="button" class="thumb{% if media.id == current.featured_media.id or forloop.first and current.featured_media == blank %} is-active{% endif %}" data-thumb data-media-id="{{ media.id }}" data-src="{{ media | image_url: width: 1000 }}" aria-label="{{ media.alt | default: product.title | escape }}">
                {{ media | image_url: width: 160, height: 160 | image_tag: loading: 'lazy', alt: '' }}
              </button>
            </li>
          {%- endfor -%}
        </ul>
        <div class="gallery__main">
          {%- assign main_media = current.featured_media | default: product.featured_media -%}
          {%- assign main_id = 'MainImage-' | append: section.id -%}
          {%- assign main_alt = main_media.alt | default: product.title -%}
          {{ main_media | image_url: width: 1000 | image_tag: id: main_id, data-main-image: '', widths: '500, 800, 1000', sizes: '(max-width: 860px) 90vw, 470px', alt: main_alt }}
        </div>
      {%- else -%}
        {%- render 'product-card-demo-gallery', section: section -%}
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Buybox ---------- {%- endcomment -%}
    {%- form 'product', product, id: form_id, class: 'buybox', data-product-form: '' -%}
      <h2 class="buybox__title">{{ product.title | escape }}</h2>
      {%- if section.settings.subtitle != blank -%}<p class="buybox__sub">{{ section.settings.subtitle | escape }}</p>{%- endif -%}

      {%- if section.settings.show_rating -%}
        <a class="rating" href="{{ routes.root_url }}#reviews">
          <span class="stars" aria-hidden="true">★★★★★</span>
          <span class="rating__score">{{ section.settings.rating_score | escape }}</span>
          <span class="rating__count">({{ section.settings.rating_count | escape }} reviews)</span>
        </a>
      {%- endif -%}

      <div class="price">
        <span class="price__now" data-price>{{ current.price | money }}</span>
        {%- if section.settings.price_note != blank -%}<span class="price__vat">{{ section.settings.price_note | escape }}</span>{%- endif -%}
      </div>

      {%- unless product.has_only_default_variant -%}
        {%- for option in product.options_with_values -%}
          {%- liquid
            assign opt_idx = forloop.index0
            assign option_name_down = option.name | downcase
            assign is_color = false
            if option_name_down contains 'colo'
              assign is_color = true
            endif
          -%}
          {%- if is_color == false -%}
            <div class="option" data-option-index="{{ opt_idx }}">
              <label class="option__label" for="{{ form_id }}-select-{{ opt_idx }}">{{ option.name | escape }}: <span data-option-value>{{ option.selected_value | escape }}</span></label>
              <div class="select">
                <select id="{{ form_id }}-select-{{ opt_idx }}" name="option-{{ opt_idx }}" class="select__field">
                  {%- for value in option.values -%}
                    <option value="{{ value | escape }}" {% if value == option.selected_value %}selected{% endif %}>{{ value | escape }}</option>
                  {%- endfor -%}
                </select>
                {% render 'icon', icon: 'chevron', size: 'chev', class: 'select__chev' %}
              </div>
            </div>
          {%- else -%}
          <fieldset class="option" data-option-index="{{ opt_idx }}">
            <legend class="option__label">{{ option.name | escape }}: <span data-option-value>{{ option.selected_value | escape }}</span></legend>
            <div class="swatches">
              {%- for value in option.values -%}
                {%- assign input_id = form_id | append: '-' | append: opt_idx | append: '-' | append: forloop.index -%}
                {%- if is_color -%}
                  {%- liquid
                    assign swatch_src = ''
                    for variant in product.variants
                      if variant.options[opt_idx] == value and variant.featured_image != blank and swatch_src == ''
                        assign swatch_src = variant.featured_image | image_url: width: 120, height: 120
                      endif
                    endfor
                    assign value_handle = value | handleize
                    if swatch_src == '' and swatch_assets contains value_handle
                      assign swatch_file = 'swatch-' | append: value_handle | append: '.jpg'
                      assign swatch_src = swatch_file | asset_img_url: '120x'
                    endif
                  -%}
                  <label class="swatch" title="{{ value | escape }}">
                    <input type="radio" id="{{ input_id }}" name="option-{{ opt_idx }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %}>
                    {%- if swatch_src != '' -%}
                      <img src="{{ swatch_src }}" alt="{{ value | escape }}" width="54" height="54">
                    {%- else -%}
                      <span class="swatch__dot" style="background: {{ value | downcase | escape }};" aria-hidden="true"></span>
                      <span class="sr-only">{{ value | escape }}</span>
                    {%- endif -%}
                  </label>
                {%- else -%}
                  <label class="pill">
                    <input type="radio" id="{{ input_id }}" name="option-{{ opt_idx }}" value="{{ value | escape }}" {% if value == option.selected_value %}checked{% endif %}>
                    <span>{{ value | escape }}</span>
                  </label>
                {%- endif -%}
              {%- endfor -%}
            </div>
          </fieldset>
          {%- endif -%}
        {%- endfor -%}
      {%- endunless -%}

      {%- if section.settings.show_tiers -%}
        {%- liquid
          assign pct2 = 100 | minus: section.settings.tier2_discount
          assign pct3 = 100 | minus: section.settings.tier3_discount
          assign total2 = current.price | times: 2 | times: pct2 | divided_by: 100
          assign total3 = current.price | times: 3 | times: pct3 | divided_by: 100
          assign each2 = total2 | divided_by: 2
          assign each3 = total3 | divided_by: 3
        -%}
        <fieldset class="tiers" data-tiers>
          <legend class="option__label">{{ section.settings.tiers_label | default: 'Bundle & save' | escape }}</legend>
          <label class="tier">
            <input type="radio" name="tier" value="1" data-tier data-qty="1" data-discount="0" checked>
            <span class="tier__qty">1 globe</span>
            <span class="tier__price"><strong data-tier-total>{{ current.price | money }}</strong></span>
          </label>
          <label class="tier">
            <input type="radio" name="tier" value="2" data-tier data-qty="2" data-discount="{{ section.settings.tier2_discount }}">
            <span class="tier__qty">2 globes <em class="tier__badge">Save {{ section.settings.tier2_discount }}%</em></span>
            <span class="tier__price"><strong data-tier-total>{{ total2 | money }}</strong><small><span data-tier-each>{{ each2 | money }}</span> each</small></span>
          </label>
          <label class="tier">
            <input type="radio" name="tier" value="3" data-tier data-qty="3" data-discount="{{ section.settings.tier3_discount }}">
            <span class="tier__qty">3 globes <em class="tier__badge tier__badge--best">Save {{ section.settings.tier3_discount }}%</em></span>
            <span class="tier__price"><strong data-tier-total>{{ total3 | money }}</strong><small><span data-tier-each>{{ each3 | money }}</span> each</small></span>
          </label>
        </fieldset>
      {%- endif -%}

      {%- assign protection = section.settings.protection_product -%}
      {%- if protection != blank and protection.available -%}
        <label class="protect">
          <input type="checkbox" name="protection" value="{{ protection.selected_or_first_available_variant.id }}" data-protection {% if section.settings.protection_default %}checked{% endif %}>
          <span class="protect__box" aria-hidden="true"></span>
          <span class="protect__text">
            <span class="protect__title">{{ section.settings.protection_label | default: 'Add Shipping Protection' | escape }} <em>+{{ protection.selected_or_first_available_variant.price | money }}</em></span>
            {%- if section.settings.protection_text != blank -%}<small>{{ section.settings.protection_text | escape }}</small>{%- endif -%}
          </span>
        </label>
      {%- endif -%}

      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <button class="btn btn--primary btn--block" type="submit" name="add" data-add-to-cart {% unless current.available %}disabled{% endunless %}>
        {% render 'icon', icon: 'cart' %}
        <span data-add-label>{% if current.available %}Add to Cart{% else %}Sold out{% endif %}</span>
      </button>
      {%- render 'buybox-extras', section: section -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <li {{ block.shopify_attributes }}>
                {% render 'icon', icon: block.settings.icon, size: 'lg' %}
                <span>{{ block.settings.text | newline_to_br }}</span>
              </li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}

      <script type="application/json" data-variants>
        [
          {%- for variant in product.variants -%}
            {
              "id": {{ variant.id }},
              "available": {{ variant.available }},
              "options": {{ variant.options | json }},
              "price": {{ variant.price | money | json }},
              "price_cents": {{ variant.price }},
              "image": {% if variant.featured_media != blank %}{{ variant.featured_media | image_url: width: 1000 | json }}{% else %}null{% endif %},
              "media_id": {% if variant.featured_media != blank %}{{ variant.featured_media.id }}{% else %}null{% endif %}
            }{% unless forloop.last %},{% endunless %}
          {%- endfor -%}
        ]
      </script>
    {%- endform -%}

  {%- else -%}
    {%- comment -%} ---------- No product assigned: demo content ---------- {%- endcomment -%}
    <div class="gallery">{%- render 'product-card-demo-gallery', section: section -%}</div>
    <div class="buybox">
      <h2 class="buybox__title">COSMOS Magnetic Levitating Globe Lamp</h2>
      <p class="buybox__sub">{{ section.settings.subtitle | default: 'Education Novelty Ball Light Desk Bookshelf Home Decoration' | escape }}</p>
      <a class="rating" href="#reviews"><span class="stars" aria-hidden="true">★★★★★</span><span class="rating__score">4.9</span><span class="rating__count">(377 reviews)</span></a>
      <div class="price"><span class="price__now">{{ 2999 | money }}</span><span class="price__vat">{{ section.settings.price_note | default: 'Price includes VAT' | escape }}</span></div>
      <fieldset class="option">
        <legend class="option__label">Colour: <span>Black</span></legend>
        <div class="swatches">
          <label class="swatch" title="Black"><input type="radio" name="demo-colour" checked disabled><img src="{{ 'swatch-black.jpg' | asset_img_url: '120x' }}" alt="Black" width="54" height="54"></label>
          <label class="swatch" title="White"><input type="radio" name="demo-colour" disabled><img src="{{ 'swatch-white.jpg' | asset_img_url: '120x' }}" alt="White" width="54" height="54"></label>
        </div>
      </fieldset>
      <div class="option">
        <label class="option__label" for="DemoSize-{{ section.id }}">Plug: <span>UK plug</span></label>
        <div class="select">
          <select id="DemoSize-{{ section.id }}" class="select__field" disabled>
            {%- assign plugs = 'EU plug,US plug,UK plug,AU plug' | split: ',' -%}
            {%- for plug in plugs -%}<option {% if plug == 'UK plug' %}selected{% endif %}>{{ plug }}</option>{%- endfor -%}
          </select>
          {% render 'icon', icon: 'chevron', size: 'chev', class: 'select__chev' %}
        </div>
      </div>
      <fieldset class="tiers">
        <legend class="option__label">Bundle & save</legend>
        <label class="tier"><input type="radio" name="demo-tier" checked disabled><span class="tier__qty">1 globe</span><span class="tier__price"><strong>{{ 2999 | money }}</strong></span></label>
        <label class="tier"><input type="radio" name="demo-tier" disabled><span class="tier__qty">2 globes <em class="tier__badge">Save 20%</em></span><span class="tier__price"><strong>{{ 4798 | money }}</strong><small>{{ 2399 | money }} each</small></span></label>
        <label class="tier"><input type="radio" name="demo-tier" disabled><span class="tier__qty">3 globes <em class="tier__badge tier__badge--best">Save 30%</em></span><span class="tier__price"><strong>{{ 6297 | money }}</strong><small>{{ 2099 | money }} each</small></span></label>
      </fieldset>
      <label class="protect">
        <input type="checkbox" disabled><span class="protect__box" aria-hidden="true"></span>
        <span class="protect__text"><span class="protect__title">Add Shipping Protection <em>+{{ 199 | money }}</em></span><small>Covers loss, theft or damage in transit.</small></span>
      </label>
      <button class="btn btn--primary btn--block" type="button" data-demo-add="Select a product for this section in the theme editor to enable Add to Cart." aria-describedby="DemoHint-{{ section.id }}">{% render 'icon', icon: 'cart' %}<span>Add to Cart</span></button>
      {%- render 'buybox-extras', section: section -%}
      <p class="buybox__hint" id="DemoHint-{{ section.id }}">Select a product for this section in the theme editor to make it shoppable.</p>
      {%- if section.blocks.size > 0 -%}
        <ul class="trust">
          {%- for block in section.blocks -%}
            {%- if block.type == 'badge' -%}
              <li {{ block.shopify_attributes }}>{% render 'icon', icon: block.settings.icon, size: 'lg' %}<span>{{ block.settings.text | newline_to_br }}</span></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
