{%- comment -%} Payment icons + delivery estimate shown under the Add to Cart button. Usage: {% render 'buybox-extras', section: section %} {%- endcomment -%}
{%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
  <ul class="payment-icons" aria-label="Accepted payment methods">
    {%- for type in shop.enabled_payment_types -%}
      <li>{{ type | payment_type_svg_tag: class: 'payment-icon' }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}
{%- if section.settings.show_delivery -%}
  {%- render 'delivery-estimate', min_days: section.settings.delivery_min_days, max_days: section.settings.delivery_max_days -%}
{%- endif -%}
