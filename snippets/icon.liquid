{%- comment -%}
  Inline stroke icons. Usage: {% render 'icon', icon: 'sun', size: 'lg' %}
{%- endcomment -%}
{%- liquid
  assign cls = 'ico'
  if size == 'lg'
    assign cls = 'ico ico--lg'
  elsif size == 'chev'
    assign cls = 'ico ico--chev'
  endif
-%}
<svg class="{{ cls }}{% if class %} {{ class }}{% endif %}" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
{%- case icon -%}
{%- when 'book' -%}<path d="M12 6c-1.5-1.5-4-2-8-2v14c4 0 6.5.5 8 2 1.5-1.5 4-2 8-2V4c-4 0-6.5.5-8 2z"/><path d="M12 6v14"/>
{%- when 'sun' -%}<circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M2 12h2M20 12h2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/>
{%- when 'home' -%}<path d="M3 11 12 3l9 8"/><path d="M5 10v10h5v-6h4v6h5V10"/>
{%- when 'globe' -%}<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.8 3 2.8 15 0 18M12 3c-2.8 3-2.8 15 0 18"/>
{%- when 'heart' -%}<path d="M12 20s-7-4.5-7-10a4 4 0 0 1 7-2.5A4 4 0 0 1 19 10c0 5.5-7 10-7 10z"/>
{%- when 'truck' -%}<path d="M3 7h11v9H3zM14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>
{%- when 'shield' -%}<path d="M12 3 4 6v6c0 5 3.5 8 8 9 4.5-1 8-4 8-9V6z"/><path d="m9 12 2 2 4-4"/>
{%- when 'lock' -%}<rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/><circle cx="12" cy="15" r="1.2"/>
{%- when 'moon' -%}<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/>
{%- when 'mute' -%}<path d="M4 10v4h3l4 4V6l-4 4z"/><path d="m16 9 5 6M21 9l-5 6"/>
{%- when 'sparkle' -%}<path d="m12 3 3 3-3 3-3-3z"/><path d="m12 15 3 3-3 3-3-3z"/><path d="m5 8 4 4-4 4M19 8l-4 4 4 4"/>
{%- when 'cart' -%}<path d="M3 4h2l2.4 11h11.2L21 7H6.2"/><circle cx="9" cy="19" r="1.5"/><circle cx="17" cy="19" r="1.5"/>
{%- when 'bag' -%}<path d="M6 8h12l-1 12H7L6 8z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/>
{%- when 'search' -%}<circle cx="11" cy="11" r="7"/><path d="m20 20-3.5-3.5"/>
{%- when 'user' -%}<circle cx="12" cy="8" r="4"/><path d="M4 21c0-4 3.6-7 8-7s8 3 8 7"/>
{%- when 'menu' -%}<path d="M4 7h16M4 12h16M4 17h16"/>
{%- when 'close' -%}<path d="M6 6l12 12M18 6 6 18"/>
{%- when 'chevron' -%}<path d="m6 9 6 6 6-6"/>
{%- when 'chevron-right' -%}<path d="m9 6 6 6-6 6"/>
{%- when 'arrow' -%}<path d="M5 12h14M13 6l6 6-6 6"/>
{%- when 'tag' -%}<circle cx="7.5" cy="7.5" r="2.5"/><circle cx="16.5" cy="16.5" r="2.5"/><path d="M19 5 5 19"/>
{%- when 'play' -%}<path d="M9 6v12l10-6z" fill="currentColor" stroke="none"/>
{%- when 'instagram' -%}<rect x="4" y="4" width="16" height="16" rx="4"/><circle cx="12" cy="12" r="3.5"/><circle cx="17" cy="7" r=".8" fill="currentColor"/>
{%- when 'tiktok' -%}<path d="M14 4v10.5a3.5 3.5 0 1 1-3.5-3.5"/><path d="M14 4c.5 3 2.5 4.5 5 4.5"/>
{%- when 'youtube' -%}<rect x="3" y="6" width="18" height="12" rx="4"/><path d="m10 9 5 3-5 3z" fill="currentColor"/>
{%- when 'pinterest' -%}<circle cx="12" cy="12" r="9"/><path d="M11 8.5c-1.5.3-2.5 1.5-2.2 3 .2 1 1 1.4 1 1.4M13 9.5c1.5.5 1.4 2.5.4 3.6-.8.9-2.1.7-2.4-.2M11.5 12l-1.6 6.5"/>
{%- when 'facebook' -%}<path d="M14 8h2V5h-2a4 4 0 0 0-4 4v2H8v3h2v6h3v-6h2.5l.5-3h-3V9a1 1 0 0 1 1-1z"/>
{%- else -%}<circle cx="12" cy="12" r="9"/>
{%- endcase -%}
</svg>
