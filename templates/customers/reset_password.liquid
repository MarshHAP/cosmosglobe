<section class="page-section">
  <div class="container container--narrow">
    <h1 class="h2">Reset password</h1>
    <p class="page-lead">Enter a new password for {{ email }}.</p>
    <div class="account">
      <div class="account__card">
        {%- form 'reset_customer_password', class: 'form' -%}
          {{ form.errors | default_errors }}
          <label for="ResetPassword">Password</label>
          <input id="ResetPassword" type="password" name="customer[password]" autocomplete="new-password" required>
          <label for="ResetPasswordConfirm">Confirm password</label>
          <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" autocomplete="new-password" required>
          <button class="btn btn--primary" type="submit">Reset password</button>
        {%- endform -%}
      </div>
    </div>
  </div>
</section>
