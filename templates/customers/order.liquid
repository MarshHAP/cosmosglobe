<section class="page-section">
  <div class="container container--narrow">
    <p class="eyebrow eyebrow--center"><a href="{{ routes.account_url }}">← Back to account</a></p>
    <h1 class="h2">Order {{ order.name }}</h1>
    <p class="page-lead">Placed on {{ order.created_at | date: '%d %B %Y' }}</p>
    {%- if order.cancelled -%}
      <p class="page-lead">Cancelled on {{ order.cancelled_at | date: '%d %B %Y' }}: {{ order.cancel_reason_label }}</p>
    {%- endif -%}

    <div class="account">
      <div class="account__card">
        <table class="table">
          <thead><tr><th>Product</th><th>SKU</th><th>Price</th><th>Qty</th><th>Total</th></tr></thead>
          <tbody>
            {%- for line_item in order.line_items -%}
              <tr>
                <td>{{ line_item.title | escape }}{% if line_item.fulfillment %}<br><small>Fulfilled {{ line_item.fulfillment.created_at | date: '%d %b %Y' }}{% if line_item.fulfillment.tracking_url %} · <a href="{{ line_item.fulfillment.tracking_url }}">Track</a>{% endif %}</small>{% endif %}</td>
                <td>{{ line_item.sku }}</td>
                <td>{{ line_item.final_price | money }}</td>
                <td>{{ line_item.quantity }}</td>
                <td>{{ line_item.final_line_price | money }}</td>
              </tr>
            {%- endfor -%}
          </tbody>
          <tfoot>
            <tr><td colspan="4">Subtotal</td><td>{{ order.line_items_subtotal_price | money }}</td></tr>
            {%- for discount_application in order.cart_level_discount_applications -%}
              <tr><td colspan="4">Discount ({{ discount_application.title | escape }})</td><td>-{{ discount_application.total_allocated_amount | money }}</td></tr>
            {%- endfor -%}
            {%- for shipping_method in order.shipping_methods -%}
              <tr><td colspan="4">Shipping ({{ shipping_method.title | escape }})</td><td>{{ shipping_method.price | money }}</td></tr>
            {%- endfor -%}
            {%- for tax_line in order.tax_lines -%}
              <tr><td colspan="4">Tax ({{ tax_line.title | escape }} {{ tax_line.rate | times: 100 }}%)</td><td>{{ tax_line.price | money }}</td></tr>
            {%- endfor -%}
            <tr><td colspan="4"><strong>Total</strong></td><td><strong>{{ order.total_price | money_with_currency }}</strong></td></tr>
          </tfoot>
        </table>
      </div>

      <div class="account__card">
        <h2>Billing address</h2>
        <p>Payment status: {{ order.financial_status_label }}</p>
        {{ order.billing_address | format_address }}
      </div>
      {%- if order.shipping_address -%}
        <div class="account__card">
          <h2>Shipping address</h2>
          <p>Fulfilment status: {{ order.fulfillment_status_label }}</p>
          {{ order.shipping_address | format_address }}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>
