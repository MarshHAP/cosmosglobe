<section class="page-section">
  <div class="container container--narrow">
    <h1 class="h2">My account</h1>
    <p class="page-lead">Welcome back{% if customer.first_name %}, {{ customer.first_name | escape }}{% endif %}. <a href="{{ routes.account_logout_url }}">Log out</a></p>

    <div class="account">
      <div class="account__card">
        <h2>Order history</h2>
        {%- paginate customer.orders by 20 -%}
          {%- if customer.orders.size == 0 -%}
            <p class="page-empty">You haven't placed any orders yet.</p>
          {%- else -%}
            <table class="table">
              <thead><tr><th>Order</th><th>Date</th><th>Payment</th><th>Fulfilment</th><th>Total</th></tr></thead>
              <tbody>
                {%- for order in customer.orders -%}
                  <tr>
                    <td><a href="{{ order.customer_url }}">{{ order.name }}</a></td>
                    <td>{{ order.created_at | date: '%d %b %Y' }}</td>
                    <td>{{ order.financial_status_label }}</td>
                    <td>{{ order.fulfillment_status_label }}</td>
                    <td>{{ order.total_price | money }}</td>
                  </tr>
                {%- endfor -%}
              </tbody>
            </table>
            {%- if paginate.pages > 1 -%}<nav class="pagination">{{ paginate | default_pagination }}</nav>{%- endif -%}
          {%- endif -%}
        {%- endpaginate -%}
      </div>

      <div class="account__card">
        <h2>Account details</h2>
        {%- if customer.default_address -%}
          <p>{{ customer.default_address | format_address }}</p>
        {%- endif -%}
        <p><a href="{{ routes.account_addresses_url }}">Manage addresses ({{ customer.addresses_count }})</a></p>
      </div>
    </div>
  </div>
</section>
